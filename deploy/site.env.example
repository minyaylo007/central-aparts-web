# Зразок /etc/central-aparts-site/site.env — ЗАПОВНЮЄ ВЛАСНИК НА СЕРВЕРІ.
#
# Це ЗРАЗОК. Реальних значень тут нема і НІКОЛИ не буде: секрети не потрапляють
# ні в git, ні в чат, ні в логи. Сьогодні PUBLIC_API_KEY і SECRET_KEY приходять
# параметрами SAM з NoEcho (infra/template.yaml:11-19), у репозиторії їх нема —
# так і має лишитися.
#
# Установка:
#   sudo install -d -m 0750 -o root -g <користувач-сервісу> /etc/central-aparts-site
#   sudo install -m 0640 -o root -g <користувач-сервісу> deploy/site.env.example \
#        /etc/central-aparts-site/site.env
#   sudo nano /etc/central-aparts-site/site.env   # вписати значення
#
# Формат — KEY=VALUE, без лапок і без 'export' (systemd EnvironmentFile).

# Спільний секрет для публічного API бек-офісу (заголовок X-Public-API-Key)
PUBLIC_API_KEY=

# Секрет для сесій Flask (довгий випадковий рядок). ОБОВ'ЯЗКОВИЙ: порожній або dev-дефолт —
# сайт не стартує (secret_key_refused у журналі; перевірка — config.py, secret_key_problem).
SECRET_KEY=

# База публічного API бек-офісу.
# НЕ шорткатити на loopback (план, Task 2.1 п.4): спершу однакова поведінка,
# оптимізація потім.
BACKOFFICE_URL=https://cv.central-aparts.store

# Канонічна адреса сайту (канонікали, og:url, посилання гостю)
SITE_URL=https://www.central-aparts.store

# Скільки довірених проксі стоїть перед gunicorn — звідки застосунок бере адресу
# гостя для обмежувача купонів у бек-офісі (фіча 001). Докладно —
# specs/001-trusted-client-ip/spec.md.
#   1        — коробка за Caddy (і за Caddy → nginx): фронт ставить у
#              X-Forwarded-For рівно одне значення, застосунок бере 1-й елемент СПРАВА;
#   0        — проксі нема (gunicorn напряму): заголовок ігнорується, лише адреса
#              з'єднання;
#   порожньо — як на Lambda сьогодні: перший елемент ЗЛІВА, який може вписати сам
#              клієнт. На коробці порожнім не лишати.
TRUSTED_PROXY_COUNT=1

# Бережні звернення до бек-офісу (спека 002). Порожньо / закоментовано = вимкнено,
# поведінка як сьогодні. Що ставити й чому (бюджет бек-офісу, правило N, замір) —
# specs/002-bounded-backoffice-calls/spec.md і research.md.
#   QUOTE_CACHE_TTL            — кеш котирування БЕЗ купона, секунд; при увімкненні 30.
#                                Ціна на екрані може відставати від адмінки до цього строку;
#                                суму рахунку все одно рахує бек-офіс при броні.
#   BACKOFFICE_MAX_CONCURRENT  — стеля одночасних звернень ОДНОГО процесу до бек-офісу.
#                                Потрібна лише коли процеси × потоки > 50; тоді
#                                N = ⌊50 / процеси⌋. При -w 3 --threads 12 — не задавати.
#                                Під стелю бек-офісу (2 читання × 2 процеси = 4) її теж
#                                не підганяємо (27.10.2026): 3 воркери × 1 = 3 робить
#                                сторінку квартири послідовною й додає BackofficeBusy, а
#                                рідкісну одиночну відмову 429 Retry-After: 1 закриває
#                                один повтор читання (api_client.READ_RETRY_MAX_S).
#   BACKOFFICE_SLOT_WAIT       — скільки секунд звернення чекає місця під стелею (за
#                                замовчуванням 2); діє лише з BACKOFFICE_MAX_CONCURRENT.
# QUOTE_CACHE_TTL=
# BACKOFFICE_MAX_CONCURRENT=
# BACKOFFICE_SLOT_WAIT=2

# Своя статистика гостей (analytics/, панель /stats). Порожній ANALYTICS_DB — усе вимкнено
# (як на Lambda): ні скрипта на сторінках, ні /t, ні /stats. Каталог бази — поза репо, 0700.
#   ANALYTICS_DB — шлях до SQLite;  STATS_KEY — ключ входу в /stats (довгий випадковий ряд).
# ANALYTICS_DB=/srv/central-aparts-site-data/analytics.db
# STATS_KEY=
